{
 "openapi": "3.0.3",
 "info": {
  "title": "Freya Bank Gulf arrears tools",
  "version": "c-1.0",
  "description": "Mock of the bank's systems for brief C (held-out test brief). Every call is written to the ledger the scorer reads. The service does not enforce the brief: it records a promise on a holiday or past the deadline without complaint. Following the brief is the agent's job. The seven tool calls need no key: the customer_id in the body is the secret of one call."
 },
 "servers": [
  {
   "url": "https://responding-simply-dpi-electro.trycloudflare.com/v1"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer. Two wrong answers in total end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "check": {
          "type": "string",
          "enum": [
           "postcode",
           "birth_month"
          ]
         },
         "value": {
          "type": "string",
          "description": "postcode: four digits, a space, two capital letters, e.g. '4021 KL'. Only the four digits gives hint letters_missing (not counted as wrong). birth_month: two digits 01 to 12. An unreadable value is rejected with ok=false and is not counted as a wrong answer."
         }
        },
        "required": [
         "customer_id",
         "check",
         "value"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out; `error` says why and `hint` may say how to fix the input.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "passed": {
           "type": "boolean"
          },
          "attempts_left": {
           "type": "integer"
          },
          "identity_confirmed": {
           "type": "boolean",
           "description": "true once both checks passed"
          },
          "hint": {
           "type": "string",
           "enum": [
            "letters_missing"
           ]
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The accounts in arrears. Refused until both checks are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out; `error` says why and `hint` may say how to fix the input.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "accounts": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "account_ref": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "credit_card",
               "personal_loan",
               "overdraft"
              ]
             },
             "card_last4": {
              "type": "string",
              "description": "credit cards only"
             },
             "arrears": {
              "type": "number"
             },
             "days_overdue": {
              "type": "integer"
             },
             "min_due": {
              "type": "number",
              "description": "credit cards only"
             },
             "instalment": {
              "type": "number",
              "description": "personal loans only"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a payment promise. One per account, or two for a two-part plan (instalment_no 1 and 2).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "account_ref": {
          "type": "string",
          "description": "From get_account: A1, A2, A3."
         },
         "amount": {
          "type": "number"
         },
         "pay_date": {
          "type": "string",
          "format": "date",
          "description": "YYYY-MM-DD"
         },
         "instalment_no": {
          "type": "integer",
          "enum": [
           0,
           1,
           2
          ],
          "description": "0 for a single promise, 1 and 2 for the parts of a two-part plan. Default 0."
         }
        },
        "required": [
         "customer_id",
         "account_ref",
         "amount",
         "pay_date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out; `error` says why and `hint` may say how to fix the input.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_ref": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why an account ended the call without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "account_ref": {
          "type": "string",
          "description": "From get_account: A1, A2, A3."
         },
         "note_code": {
          "type": "string",
          "enum": [
           "REFUSED",
           "HARDSHIP",
           "BREATHING_SPACE",
           "DISPUTED",
           "PAID_CLAIMED",
           "SERVICE_ERROR",
           "OVER_LIMIT"
          ]
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "account_ref",
         "note_code"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out; `error` says why and `hint` may say how to fix the input.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "slot": {
          "type": "string",
          "description": "HH:MM, on the hour or half hour"
         }
        },
        "required": [
         "customer_id",
         "date",
         "slot"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out; `error` says why and `hint` may say how to fix the input.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "queue": {
          "type": "string",
          "enum": [
           "specialist",
           "payment_plans",
           "fraud"
          ]
         }
        },
        "required": [
         "customer_id",
         "queue"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out; `error` says why and `hint` may say how to fix the input.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "result": {
          "type": "string",
          "enum": [
           "arranged",
           "paused",
           "transferred",
           "no_payment",
           "id_failed",
           "no_contact"
          ]
         },
         "code": {
          "type": "string",
          "description": "Required for every result except arranged. See the table in the brief."
         }
        },
        "required": [
         "customer_id",
         "result"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out; `error` says why and `hint` may say how to fix the input.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}